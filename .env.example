# TRCMS backend environment — copy this file to ".env" and fill in.
# The .env file is git-ignored; NEVER commit real secrets.

# --- Database -------------------------------------------------------------
# URL form:  mysql://USER:PASSWORD@HOST:PORT/DATABASE
# For local development, point this at YOUR OWN local database (see
# DEVELOPMENT.md). Never point a dev checkout at the production database.
DATABASE_URL=mysql://root:@localhost:3306/trcms_dev

# --- Auth -----------------------------------------------------------------
# Any random string works for local development (it only signs your local
# login tokens). Generate one, e.g.:  php -r "echo bin2hex(random_bytes(32));"
SECRET_KEY=change-me-to-any-random-string-for-local-dev
# Encryption key for the sealed incident-report vault (generate like SECRET_KEY).
INCIDENT_VAULT_KEY=change-me-to-a-fresh-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# development = enables dev-only behavior (and lets deploy/seed_dev.php run).
ENVIRONMENT=development

# --- App ------------------------------------------------------------------
# Allowed browser origins (CORS). For single-port local serving, the app's
# own origin is fine.
ALLOWED_ORIGINS=http://localhost:8090
APP_URL=http://localhost:8090
ORG_NAME="My Organization"

# Local timezone used to reckon "today" on check-in screens (PHP tz name).
APP_TIMEZONE=America/Chicago

# --- Email (optional for local dev; leave blank to disable sending) -------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# System backups (bin/backup.php). Defaults are used if unset.
# BACKUP_DIR=/path/to/your/backups
# BACKUP_KEEP_WEEKLY=8
# BACKUP_KEEP_MONTHLY=12
# BACKUP_KEEP_YEARLY=3
# MYSQLDUMP_BIN=mysqldump

# Optional logo image path/URL (empty = text wordmark from the org name initials)
LOGO_URL=
