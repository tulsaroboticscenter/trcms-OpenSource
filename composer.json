{
    "name": "trc/trcpms-php",
    "description": "TRC Program Management System — PHP API (port of the FastAPI backend; same PostgreSQL DB).",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pgsql": "*",
        "geoip2/geoip2": "^3.4",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
