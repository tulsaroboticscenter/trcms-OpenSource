# ─────────────────────────────────────────────────────────────────────────────
# Online payments (Square + PayPal). Copy these keys into your .env file and
# fill in the values. SANDBOX values are safe test-only credentials — start
# there, prove the flow with test cards, THEN switch *_ENV to "production" and
# paste live credentials. Never commit real values (.env is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. Leave false until at least one provider below is configured.
PAYMENTS_ENABLED=false

# Where the app's UI lives (payer is redirected back here after paying).
APP_URL=https://trcms.tulsaroboticscenter.org
# Public base URL of THIS API (provider redirects + webhooks hit it). If the API
# and UI share a host, set it the same as APP_URL. Must be internet-reachable.
API_URL=https://trcms.tulsaroboticscenter.org

# ── Square ──────────────────────────────────────────────────────────────────
# Developer Dashboard → your app → Sandbox (or Production) tab.
SQUARE_ENV=sandbox                     # sandbox | production
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Set after you add a webhook subscription in Square pointing at:
#   {API_URL}/api/v1/webhooks/square      (subscribe to payment.updated, refund.updated)
SQUARE_WEBHOOK_SIGNATURE_KEY=
# The EXACT notification URL you entered in Square (used to verify signatures):
SQUARE_WEBHOOK_URL=https://trcms.tulsaroboticscenter.org/api/v1/webhooks/square

# Processing-fee rates used for the optional "cover the fee" checkout toggle
# (gross-up so TRC nets the full fee). Defaults shown; adjust to your real rates.
SQUARE_FEE_PCT=2.6
SQUARE_FEE_FIXED=0.10

# ── PayPal ──────────────────────────────────────────────────────────────────
# Developer Dashboard → Apps & Credentials → Sandbox (or Live) → your app.
PAYPAL_ENV=sandbox                     # sandbox | production
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after you add a webhook in PayPal pointing at:
#   {API_URL}/api/v1/webhooks/paypal      (subscribe to PAYMENT.CAPTURE.COMPLETED,
#                                           PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED)
PAYPAL_WEBHOOK_ID=
