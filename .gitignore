# .gitignore for the PUBLIC TRCMS repo (monorepo layout: backend at root, React source in /frontend).
# Copy this to `.gitignore` at the root of the public repo.

# ── Secrets & environment ──────────────────────────────────────────────
.env
.env.*
!.env.example
deploy/.env*
config/*.env
!config/*.env.example
*.pem
*.key

# ── PHP dependencies (run `composer install`) ──────────────────────────
/vendor/

# ── Frontend: node + build output (run `npm ci && npm run build`) ──────
/frontend/node_modules/
/frontend/dist/

# ── Built frontend assets served by the backend (generated by the build) ──
/public/assets/
/public/index.html

# ── Runtime data / uploads (keep the folder, not its contents) ─────────
/public/uploads/*
!/public/uploads/.gitkeep
*.log

# ── Real-data / organization-specific operational scripts — NEVER publish ──
deploy/mysql_import.sql
deploy/mysql_schema.sql
deploy/schema.sql
deploy/snapshots/
deploy/cleanup_*.sql
deploy/fix_*.sql
deploy/seed_*_tef.sql
deploy/*_batch*.sql
# (Keep deploy/migrations/** — that IS the canonical schema.)

# ── OS / editor cruft ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
